{
  "name": "orbitmart-api",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "postbuild": "cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@clerk/backend": "^1.3.0",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "helmet": "^7.1.0",
    "pg": "^8.11.3",
    "svix": "^1.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
