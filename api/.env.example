# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/orbitverify

# Redis
REDIS_URL=redis://localhost:6379

# JWT — RS256 keys (generate with: openssl genrsa -out private.pem 2048)
VIT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
VIT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
S3_BUCKET_NAME=orbitverify-id-photos

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Termii (African SMS fallback)
TERMII_API_KEY=
TERMII_SENDER_ID=OrbitVerify

# Smile Identity
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=
SMILE_IDENTITY_ENV=sandbox
# Callback URL Smile Identity will POST job results to (optional — biometric processor polls regardless)
SMILE_IDENTITY_CALLBACK_URL=https://api.orbitverify.africa/v1/webhooks/smile

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://console.orbitverify.africa
