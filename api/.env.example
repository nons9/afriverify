# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/afriverify

# Redis
REDIS_URL=redis://localhost:6379

# JWT — RS256 keys for VIT signing (generate with: openssl genrsa -out private.pem 2048)
VIT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
VIT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Session JWT — for developer portal login (any long random string)
SESSION_JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Storage (S3-compatible) - real AWS S3, or any S3-compatible store like
# Cloudflare R2. For R2, also set AWS_ENDPOINT_URL to your R2 account's
# S3 API endpoint (https://<account-id>.r2.cloudflarestorage.com) and
# AWS_REGION=auto; leave AWS_ENDPOINT_URL unset to use real AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_ENDPOINT_URL=
S3_BUCKET_NAME=afriverify-id-photos

# OTP delivery - plain SMS send, tried in this order, first configured one
# that succeeds wins. None are required; the service degrades to "OTP
# service unavailable" if none are set or all fail.

# Twilio (plain SMS, not the Verify product - needs a purchased/verified from-number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Africa's Talking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Termii
TERMII_API_KEY=
TERMII_SENDER_ID=AfriVerify

# Smile Identity
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=
SMILE_IDENTITY_ENV=sandbox
SMILE_IDENTITY_CALLBACK_URL=https://api.afriverify.com/v1/webhooks/smile

# Webhook signing secret (default used when a developer has not configured their own)
AFRIVERIFY_DEFAULT_WEBHOOK_SECRET=change-this-to-a-long-random-secret

# At-rest encryption for stored PII: ID photos, selfies, and webhook signing
# secrets. Required. Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001,https://afriverify.vercel.app

# Observability. Both optional. The service runs fine with neither set.
# SENTRY_DSN: structured error tracking (sentry.io project settings -> Client Keys).
SENTRY_DSN=
# ALERT_WEBHOOK_URL: a Slack incoming webhook URL (or any endpoint accepting
# {text: string}) that gets a message when a monitored event type's failure
# rate crosses ALERT_FAILURE_RATE_THRESHOLD (default 0.5) over
# ALERT_WINDOW_MINUTES (default 30), checked every ALERT_CHECK_INTERVAL_MINUTES
# (default 15). With no ALERT_WEBHOOK_URL, breaches are still logged.
ALERT_WEBHOOK_URL=

# Data retention: ID photos/selfies from a verification attempt that never
# completed (failed, or abandoned) are deleted after this many days. Photos
# from a completed verification are not touched by this job. See
# docs/DATA_RETENTION.md.
SESSION_MEDIA_RETENTION_DAYS=30
